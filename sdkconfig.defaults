# ESP32-C3 默认配置 — 编译时可通过 idf.py menuconfig 覆盖

# Flash 大小 4MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# FreeRTOS 心跳频率 1000Hz (1ms tick) — 调光和按键时序需要毫秒精度
CONFIG_FREERTOS_HZ=1000

# 启用 FreeRTOS 递归互斥锁 (状态机用到)
CONFIG_FREERTOS_ENABLE_RECURSIVE_MUTEX=y

# Wi-Fi 配置
CONFIG_ESP_WIFI_ENABLED=y

# MQTT 最大 broker URI 长度
CONFIG_MQTT_TASK_STACK_SIZE=6144

# 分区表 — 自定义 OTA 双分区
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# 启用 OTA 回滚机制 (OTA失败自动回退到上一个可用固件)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 允许 HTTP 下载固件 (非 HTTPS, 适用于局域网测试)
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# 启用证书包 (HTTPS 固件下载验证服务器证书)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# 日志级别 (开发时用 Verbose/Debug, 量产改 Info/Warning)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
